---
import { Image } from 'astro:assets';
import portrait from '../portrait.jpg';
import PageLayout from '../layouts/PageLayout.astro';
import EditorialLink from '../components/EditorialLink.astro';
import ContentRow from '../components/ContentRow.astro';
import { publicContent, href } from '../lib/content';
import { site } from '../lib/site';
const investigations = (await publicContent('investigations')).filter(e => e.data.featured);
const projects = (await publicContent('projects')).filter(e => e.data.featured);
const articles = (await publicContent('articles')).slice(0, 3);
---
<PageLayout>
  <section class="hero" aria-labelledby="hero-title"><div class="hero-text dot-grid"><div class="hero-intro eyebrow"><span class="small-cross" aria-hidden="true">+</span> A mind at work</div><div class="hero-center"><h1 id="hero-title" class="hero-tagline">I explore and solve<br />complex problems<br />with AI, blockchain,<br />and simulations.</h1><div class="hero-links"><EditorialLink href="/projects/">Projects</EditorialLink><EditorialLink href="/writing/">Blogs</EditorialLink><EditorialLink href="/story/">My Story</EditorialLink></div></div><div class="hero-bottom"><p>Computer Science at Ashoka.<br />Exploring the possible with TKS.</p><a href="#questions">Step inside the lab <span aria-hidden="true">↓</span></a></div></div><div class="hero-photo"><Image src={portrait} widths={[420, 640, 960, 1280]} sizes="(max-width: 767px) 92vw, 36vw" alt="Ronit speaking into a microphone at an event, with the original presentation background." loading="eager" fetchpriority="high" format="webp" /></div></section>
  <section class="section container lab-section" id="questions"><div class="section-heading"><div><p class="eyebrow">01 / The research lab</p><h2>It starts with<br /><em>a question.</em></h2></div><div class="section-intro"><p>I’m Ronit. I study things that puzzle me, build to test what I learn, and keep track of what I still don’t understand.</p><EditorialLink href="/explore/">Explore the lab</EditorialLink></div></div><div class="question-previews">{investigations.map((entry, i) => <article class="question-preview"><div class="preview-meta"><span class="row-number">Q. {String(i + 1).padStart(2, '0')}</span><span class="status"><span class="status-dot" aria-hidden="true"></span>{'status' in entry.data && entry.data.status}</span></div><h3><a href={href(entry)}>{'question' in entry.data && entry.data.question} <span class="arrow" aria-hidden="true">↗</span></a></h3><p>{entry.data.summary}</p><ul class="topics">{entry.data.topics.map(topic => <li>{topic}</li>)}</ul></article>)}</div></section>
  <section class="section container"><div class="section-heading"><div><p class="eyebrow">02 / From thinking to making</p><h2>On the workbench.</h2></div><EditorialLink href="/projects/">All projects</EditorialLink></div>{projects.map((entry, i) => <ContentRow entry={entry} index={i} />)}</section>
  <section class="notebook-section dot-grid"><div class="container notebook-inner"><div><p class="eyebrow">03 / Writing to understand</p><h2>A notebook,<br /><em>taking shape.</em></h2></div><div>{articles.length ? articles.map(entry => <ContentRow entry={entry} />) : <><p class="notebook-copy">Research becomes clearer when I try to explain it. This space will hold the deep dives, field notes and build logs that come out of the work.</p><p class="muted">The first pieces are still being prepared.</p></>}<EditorialLink href="/writing/">Visit the notebook</EditorialLink></div></div></section>
  <section class="section container curiosity-section"><div><p class="eyebrow">04 / Beyond the current experiments</p><h2>Still curious.</h2><p class="muted">A few questions I’m carrying around.</p></div><ul class="curiosity-list">{site.curiosities.map(item => <li><span class="eyebrow">{item.topic}</span>{item.href ? <a href={item.href}>{item.question} <span aria-hidden="true">↗</span></a> : <p>{item.question}</p>}</li>)}</ul></section>
  <section class="section container home-about"><p class="eyebrow">The person behind the questions</p><h2>Understand deeply.<br /><em>Then build something useful.</em></h2><p>I’m studying Computer Science at Ashoka University and participating in The Knowledge Society. My interests move between AI, financial systems and emerging technologies. What connects them is the desire to turn understanding into something useful.</p><EditorialLink href="/story/">A little more about me</EditorialLink></section>
</PageLayout>
