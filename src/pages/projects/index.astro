---
import GradientField from '../../components/GradientField.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import ContentRow from '../../components/ContentRow.astro';
import Filters from '../../components/Filters.astro';
import { publicContent } from '../../lib/content';
const entries = await publicContent('projects');
const topics = [...new Set(entries.flatMap(e => e.data.topics))];
const statuses = [...new Set(entries.map(e => 'status' in e.data ? e.data.status : ''))];
---
<PageLayout title="Projects" description="An A2A/x402 learning reimplementation, a live personal finance app, and the research and writing behind them."><section class="page-intro dot-grid"><GradientField /><div class="container"><p class="eyebrow">Projects / Ideas meet the real world</p><h1>Thinking is a start.<br /><em>Building asks more.</em></h1><p class="lead">From a research paper to a local agent payment prototype. From a problem close to home to a live finance app. Explore the code, try the app, and follow what I learned.</p></div></section><section class="container collection-section" aria-label="Projects"><Filters topics={topics} statuses={statuses} noun="projects" />{entries.map((entry, i) => <ContentRow entry={entry} index={i} />)}<div class="empty-state" hidden data-filter-empty><h2>No projects match those filters.</h2><p>Try another status or reset the filters.</p></div></section></PageLayout>
