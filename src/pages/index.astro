---
import { Image } from 'astro:assets';
import portrait from '../portrait.jpg';
import PageLayout from '../layouts/PageLayout.astro';
import GradientField from '../components/GradientField.astro';
import { publicContent, href } from '../lib/content';
const investigations = (await publicContent('investigations')).filter(e => e.data.featured);
const projects = (await publicContent('projects')).filter(e => e.data.featured);
const articles = (await publicContent('articles')).slice(0, 3);
---
<PageLayout home>
  <section class="home-hero" aria-labelledby="hero-title">
    <GradientField />
    <div class="hero-guides" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="home-frame hero-content">
      <p class="home-kicker"><span class="live-dot" aria-hidden="true"></span> Projects, research &amp; experiments <span class="hero-edition">Build. Learn. Share.</span></p>
      <h1 id="hero-title">I explore and solve<br />complex problems<br /><span>with AI, blockchain,<br />and simulations.</span></h1>
      <div class="hero-description"><p>I’m Ronit. Here are the systems I’m building, the ideas I’m testing, and what I’m learning along the way.</p><a class="home-primary" href="#work">Explore my projects <span aria-hidden="true">↗</span></a></div>
      <div class="home-hero-bottom"><span>Computer Science at Ashoka <span class="separator">/</span> The Knowledge Society</span><a href="#work">A little further down <span aria-hidden="true">↓</span></a></div>
    </div>
  </section>
  <div class="home-frame home-body">
    <section class="home-section work-section" id="work" aria-labelledby="work-title">
      <div class="home-section-head" data-reveal><p class="home-kicker">01 <span>/</span> Selected projects</p><div><h2 id="work-title">Built to understand.</h2><p>A learning prototype, a live app, and the work behind them.</p></div><a class="home-text-link" href="/projects/">All projects <span aria-hidden="true">↗</span></a></div>
      {projects.map((entry, i) => <article class="home-project" data-reveal>{entry.id === 'agent-payment-architecture' ? <div class="project-drawing payment-drawing" aria-hidden="true"><span class="drawing-label">A2A + x402 / Local prototype</span><ol class="project-flow"><li><span>01</span>Read AgentCard</li><li><span>02</span>Request service</li><li><span>03</span>Settle payment</li><li><span>04</span>Receive result</li></ol><span class="drawing-caption">Agent identity → paid service → local test settlement</span></div> : <div class="project-drawing" aria-hidden="true"><span class="drawing-label">Fig. {String(i + 1).padStart(2, '0')} / Systems in balance</span><svg viewBox="0 0 480 240" fill="none"><path d="M40 180H440M80 40V210M160 40V210M240 40V210M320 40V210M400 40V210" stroke="currentColor" opacity=".12"/><path d="M80 160L160 120L240 140L320 64L400 88" stroke="currentColor" stroke-width="2"/><path d="M80 180V160M160 180V120M240 180V140M320 180V64M400 180V88" stroke="currentColor" opacity=".4"/>{[[80,160],[160,120],[240,140],[320,64],[400,88]].map(([cx,cy]) => <circle cx={cx} cy={cy} r="4" fill="currentColor" />)}</svg><span class="drawing-caption">A clearer picture of everyday finances.</span></div>}<div class="home-project-copy"><p class="home-kicker">{'status' in entry.data && entry.data.status}</p><h3><a href={href(entry)}>{entry.data.title}</a></h3><p>{entry.data.summary}</p><div class="home-project-links"><a class="home-text-link" href={href(entry)}>Inside the project <span aria-hidden="true">↗</span></a>{'repoUrl' in entry.data && entry.data.repoUrl && <a class="home-text-link" href={entry.data.repoUrl}>View GitHub <span aria-hidden="true">↗</span></a>}{'demoUrl' in entry.data && entry.data.demoUrl && <a class="home-text-link" href={entry.data.demoUrl}>Open live app <span aria-hidden="true">↗</span></a>}</div></div></article>)}
    </section>
    <section class="home-section" id="questions" aria-labelledby="questions-title">
      <div class="home-section-head" data-reveal><p class="home-kicker">02 <span>/</span> Behind the projects</p><div><h2 id="questions-title">It starts with a question.</h2><p>Following the questions that don’t have easy answers.</p></div><a class="home-text-link" href="/explore/">All investigations <span aria-hidden="true">↗</span></a></div>
      <div class="investigation-list">{investigations.map((entry, i) => <article class="investigation" data-reveal><div class="investigation-meta"><span>Q.{String(i + 1).padStart(2, '0')}</span><span class="home-status"><span class="live-dot" aria-hidden="true"></span>{'status' in entry.data && entry.data.status}</span></div><div class="investigation-copy"><h3><a href={href(entry)}>{'question' in entry.data && entry.data.question}<span aria-hidden="true">↗</span></a></h3><p>{entry.data.summary}</p><ul class="home-topics" aria-label="Topics">{entry.data.topics.map(topic => <li>{topic}</li>)}</ul></div></article>)}</div>
    </section>
    <section class="home-notebook" data-reveal aria-labelledby="notebook-title"><p class="home-kicker">03 <span>/</span> Writing from the work</p><div><h2 id="notebook-title">Writing is part<br />of figuring it out.</h2><p>What I learn from researching a problem and turning it into a project.</p>{articles.length ? articles.map(entry => <a class="home-article" href={href(entry)}>{entry.data.title} <span aria-hidden="true">↗</span></a>) : <p class="notebook-status"><span class="live-dot" aria-hidden="true"></span> The first pieces are in the works.</p>}<a class="home-text-link" href="/writing/">Visit the notebook <span aria-hidden="true">↗</span></a></div></section>
    <section class="home-person" data-reveal aria-labelledby="person-title"><div class="home-person-photo"><Image src={portrait} widths={[240, 480, 720]} sizes="(max-width: 767px) 70vw, 240px" alt="Ronit speaking into a microphone at an event." format="webp" loading="lazy" /></div><div><p class="home-kicker">The person behind the questions</p><h2 id="person-title">A mind at work.<br />Always a work in progress.</h2><p>I study Computer Science at Ashoka University and explore emerging technologies with The Knowledge Society. I’m interested in what happens when deep understanding meets the desire to make something useful.</p><a class="home-text-link" href="/story/">A little more about me <span aria-hidden="true">↗</span></a></div></section>
  </div>
</PageLayout>
<script>
  const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (!motion.matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08 });
    document.querySelectorAll('[data-reveal]').forEach(element => {
      // Never hide content above the fold or in browsers without an observer.
      if (element.getBoundingClientRect().top > window.innerHeight) element.classList.add('will-reveal');
      observer.observe(element);
    });
  }
</script>
