---
import GradientField from '../../components/GradientField.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import ContentRow from '../../components/ContentRow.astro';
import EditorialLink from '../../components/EditorialLink.astro';
import Filters from '../../components/Filters.astro';
import { publicContent } from '../../lib/content';
const entries = await publicContent('articles');
---
<PageLayout title="Writing" description="Published writing and notes from my projects, including what I learned researching blockchain and agentic payments."><section class="page-intro dot-grid"><GradientField /><div class="container"><p class="eyebrow">Writing / Making sense of the work</p><h1>Notes from<br /><em>an unfinished mind.</em></h1><p class="lead">Articles and notes from the work: what I researched, what I tried to build, and what I learned along the way.</p></div></section><section class="container collection-section">{entries.length > 0 ? <><Filters topics={[...new Set(entries.flatMap(e => e.data.topics))]} statuses={[...new Set(entries.map(e => 'type' in e.data ? e.data.type : ''))]} noun="writing" />{entries.map(entry => <ContentRow entry={entry} />)}<div hidden data-filter-empty class="empty-state"><h2>No pieces match those filters.</h2><p>Try another topic or reset the filters.</p></div></> : <div class="writing-empty"><span class="notebook-mark" aria-hidden="true">↳</span><div><p class="eyebrow">The notebook is open</p><h2>The first pages are still taking shape.</h2><p>There are no published articles here yet. I’m working through questions about agent payments, programmable trust, and evaluating intelligent systems.</p><p>For now, you can follow those questions in the lab—where the current thinking and its limitations are visible.</p><EditorialLink href="/explore/">Read the investigations</EditorialLink></div></div>}</section><section class="container writing-formats"><p class="eyebrow">What this space will hold</p><div><h2>Research articles</h2><p>A question, an approach, the evidence, and the limitations.</p></div><div><h2>Field notes</h2><p>Small discoveries and questions worth returning to.</p></div><div><h2>Build logs</h2><p>Experiments, mistakes, and what changed along the way.</p></div><div><h2>Essays</h2><p>Arguments and reflections, with room for uncertainty.</p></div></section></PageLayout>
