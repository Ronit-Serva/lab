---
const current = Astro.url.pathname;
const links = [{ href: '/explore/', label: 'Explore' }, { href: '/writing/', label: 'Writing' }, { href: '/projects/', label: 'Projects' }, { href: '/story/', label: 'My Story' }];
---
<header class="site-header">
  <a href="/" class="wordmark" aria-label="Ronit Serva, home"><span class="wordmark-symbol" aria-hidden="true">r.</span><span>Ronit Serva<span class="wordmark-sub">A personal research lab</span></span></a>
  <nav aria-label="Main navigation" class="desktop-nav">{links.map(link => <a href={link.href} aria-current={current.startsWith(link.href) ? 'page' : undefined}>{link.label}</a>)}</nav>
  <div class="header-actions"><button hidden data-search-open class="search-trigger" aria-label="Search the lab"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10" cy="10" r="6" /><path d="m15 15 5 5" /></svg><span>Search</span></button><a href="/contact/" class="header-contact">Let’s talk <span aria-hidden="true">↗</span></a></div>
  <details class="mobile-menu"><summary>Menu <span aria-hidden="true">+</span></summary><nav aria-label="Mobile navigation">{links.map(link => <a href={link.href} aria-current={current.startsWith(link.href) ? 'page' : undefined}>{link.label} <span aria-hidden="true">↗</span></a>)}<a href="/contact/">Let’s talk ↗</a></nav></details>
</header>
