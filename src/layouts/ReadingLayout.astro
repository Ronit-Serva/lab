---
import GradientField from '../components/GradientField.astro';
import PageLayout from './PageLayout.astro';
import ConnectedContent from '../components/ConnectedContent.astro';
import SettlementDiagram from '../components/SettlementDiagram.astro';
import { kindLabels, roots, formatDate, type Entry } from '../lib/content';
interface Props { entry: Entry; headings: { depth: number; slug: string; text: string }[]; }
const { entry, headings } = Astro.props;
const data = entry.data;
const title = 'question' in data ? data.question : data.title;
const status = 'status' in data ? data.status : data.type;
---
<PageLayout title={title} description={data.summary} noindex={data.visibility !== 'public'}>
  <div class="reading-hero dot-grid"><GradientField /><div class="container"><a class="back-link" href={`${roots[entry.collection]}/`}>← All {entry.collection === 'articles' ? 'writing' : entry.collection}</a><div class="reading-meta"><span class="eyebrow">{kindLabels[entry.collection]}</span><span class="status"><span class="status-dot" aria-hidden="true"></span>{status}</span></div><h1>{title}</h1><p class="lead">{data.summary}</p><ul class="topics">{data.topics.map(topic => <li>{topic}</li>)}</ul>{'publishedAt' in data && data.publishedAt && <p class="date">Published {formatDate(data.publishedAt)}</p>}{data.updatedAt && <p class="date">Updated {formatDate(data.updatedAt)}</p>}{'stack' in data && data.stack.length > 0 && <p class="stack"><span>Built with</span> {data.stack.join(' / ')}</p>}<div class="reading-destinations">{'repoUrl' in data && data.repoUrl && <a class="home-text-link" href={data.repoUrl}>View code on GitHub <span aria-hidden="true">↗</span></a>}{'demoUrl' in data && data.demoUrl && <a class="home-text-link" href={data.demoUrl}>Open live app <span aria-hidden="true">↗</span></a>}{'externalUrl' in data && data.externalUrl && <a class="home-text-link" href={data.externalUrl}>Read the article on Medium <span aria-hidden="true">↗</span></a>}</div></div></div>
  <div class="container reading-grid"><aside class="reading-aside"><p class="eyebrow">In this {entry.collection === 'investigations' ? 'investigation' : entry.collection === 'articles' ? 'piece' : 'case study'}</p><nav aria-label="Table of contents">{headings.filter(h => h.depth === 2).map(h => <a href={`#${h.slug}`}>{h.text}</a>)}</nav><p class="aside-note">Questions first.<br />Evidence always.<br />Room to change my mind.</p></aside><div class="reading-body"><article class="prose"><slot /></article><slot name="demo" />{entry.id === 'agent-payment-architecture' && <SettlementDiagram />}{'openQuestions' in data && <section class="open-questions" aria-labelledby="open-heading"><p class="eyebrow">Still on the workbench</p><h2 id="open-heading">What I don’t know yet.</h2><ol>{data.openQuestions.map(question => <li>{question}</li>)}</ol></section>}{data.references.length > 0 && <section class="references"><h2>Sources & further reading</h2><p>Primary documentation for the systems and limitations discussed here.</p><ul>{data.references.map(ref => <li><a href={ref.url}>{ref.title} <span aria-hidden="true">↗</span></a></li>)}</ul></section>}{'repoUrl' in data && (data.repoUrl || data.demoUrl) && <div class="project-destinations">{data.repoUrl && <a href={data.repoUrl}>View source ↗</a>}{data.demoUrl && <a href={data.demoUrl}>Try the project ↗</a>}</div>}<ConnectedContent entry={entry} /></div></div>
</PageLayout>

<script>
  document.querySelectorAll<HTMLElement>('.prose pre').forEach(block => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'copy-code';
    button.textContent = 'Copy code';
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(block.querySelector('code')?.textContent || '');
        button.textContent = 'Copied';
      } catch {
        button.textContent = 'Select code to copy';
      }
      setTimeout(() => { button.textContent = 'Copy code'; }, 1800);
    });
    block.before(button);
  });
</script>
