---
import GradientField from '../../components/GradientField.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import ContentRow from '../../components/ContentRow.astro';
import Filters from '../../components/Filters.astro';
import { publicContent } from '../../lib/content';
const entries = await publicContent('investigations');
const topics = [...new Set(entries.flatMap(e => e.data.topics))];
const statuses = [...new Set(entries.map(e => 'status' in e.data ? e.data.status : ''))];
---
<PageLayout title="Explore the lab" description="Questions about agentic payments, trust and personal finance—research, experiments and what remains unresolved."><section class="page-intro dot-grid"><GradientField /><div class="container"><p class="eyebrow">The research lab / Questions in motion</p><h1>Follow a question.<br /><em>See where it leads.</em></h1><p class="lead">A place for the problems I’m working through, the approaches I’m considering, and the questions that refuse easy answers.</p></div></section><section class="container collection-section" aria-label="Research investigations"><Filters topics={topics} statuses={statuses} noun="investigations" />{entries.map((entry, i) => <ContentRow entry={entry} index={i} question />)}<div class="empty-state" hidden data-filter-empty><h2>No questions match those filters.</h2><p>Try another theme, or reset the filters to see the whole lab.</p></div><aside class="collection-note"><span class="small-cross" aria-hidden="true">+</span><p>The lab is deliberately unfinished. An open question is an invitation to think together.</p></aside></section></PageLayout>
